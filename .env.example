# Local web server (127.0.0.1 = this machine only)
QILLQA_HOST=127.0.0.1
QILLQA_PORT=47391
# Access token for the web UI and API (setup.sh generates one if empty)
QILLQA_TOKEN=
# Where pages live (relative to this folder, or absolute)
QILLQA_PAGES_DIR=./pages
# Embedding model (sentence-transformers)
QILLQA_MODEL=Qwen/Qwen3-Embedding-0.6B
# Idle minutes before the model process exits (frees RAM and VRAM)
QILLQA_MODEL_IDLE_MIN=15
# Minimum score for a search result (calibrated for Qwen3-Embedding-0.6B)
QILLQA_MIN_SCORE=0.3
# cuda | cpu | empty = cuda when a GPU is available
QILLQA_DEVICE=
