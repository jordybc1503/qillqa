# Servidor web local (127.0.0.1 = solo esta máquina)
QILLQA_HOST=127.0.0.1
QILLQA_PORT=47391
# Token de acceso a la web y la API (setup.sh lo genera si está vacío)
QILLQA_TOKEN=
# Dónde viven las páginas (relativo a esta carpeta o absoluto)
QILLQA_PAGES_DIR=./pages
# Modelo de embeddings (sentence-transformers)
QILLQA_MODEL=Qwen/Qwen3-Embedding-0.6B
# Minutos sin uso para cerrar el proceso del modelo (libera RAM y VRAM)
QILLQA_MODEL_IDLE_MIN=15
# Score mínimo para mostrar un resultado (calibrado para Qwen3-Embedding-0.6B)
QILLQA_MIN_SCORE=0.3
# cuda | cpu | vacío = cuda si hay GPU
QILLQA_DEVICE=
